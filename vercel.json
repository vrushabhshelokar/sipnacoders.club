
{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "vibeathon.sipnacoders.club"
        }
      ],
      "destination": "https://sipnacoders.club/upcoming",
      "permanent": false
    }
  ]
}
